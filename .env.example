# Copy to .env for local use. Never commit real credentials.
PORT=3000
TRUST_PROXY=0
# Manual tools work with this false and without any API credentials.
ENABLE_EXTERNAL_SERVICES=false
# To enable online features, set true above and add only the keys you need.
# Institutional photo pilots: use a billing-enabled Google project and review
# Google's current retention, age and audience terms before enabling.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PLACES_API_KEY=
# Separate browser-visible Maps JavaScript key with HTTP referrer restrictions.
MAPS_BROWSER_API_KEY=
# Optional in-app walking route estimates; external Google directions links
# work without this server key.
ROUTES_API_KEY=
# Optional. Tried once when GEMINI_MODEL is over quota or under load.
GEMINI_FALLBACK_MODEL=gemini-flash-latest
